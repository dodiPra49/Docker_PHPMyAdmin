# Port phpMyAdmin di mesin lokal
# Catatan: Port 8080, 8081, dan 8085 sedang digunakan container lain di PC Anda.
PMA_PORT=8086

# Port MariaDB di mesin lokal
# Catatan: Port 3306, 3307, dan 3308 sudah terpakai di PC Anda, sehingga port 3309 digunakan agar aman.
MARIADB_PORT=3309

# Konfigurasi Database MariaDB
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=my_database
MARIADB_USER=dbuser
MARIADB_PASSWORD=dbpass

# Host database default untuk phpMyAdmin (mengarah langsung ke service container 'mariadb')
PMA_HOST=mariadb
PMA_PORT_DB=3306

# Batas ukuran upload file SQL (default phpMyAdmin hanya 2MB)
PMA_UPLOAD_LIMIT=256M
