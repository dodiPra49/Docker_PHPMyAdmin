# ==========================================
# Konfigurasi Port
# ==========================================
# Port akses phpMyAdmin dari luar
PMA_PORT=8086

# Port akses MariaDB dari luar
MARIADB_PORT=3309

# ==========================================
# Kredensial Database MariaDB
# ==========================================
MARIADB_ROOT_PASSWORD=ganti_dengan_root_password_aman
MARIADB_DATABASE=my_database
MARIADB_USER=dbuser
MARIADB_PASSWORD=ganti_dengan_password_user_aman

# ==========================================
# Konfigurasi phpMyAdmin
# ==========================================
# Host database default (diarahkan ke nama container internal)
PMA_HOST=mariadb
PMA_PORT_DB=3306

# Batas ukuran upload file SQL (.sql / .zip)
PMA_UPLOAD_LIMIT=256M
